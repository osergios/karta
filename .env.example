# ---- Ergani ----
# ERGANI_MODE decides where card movements go (the URL follows the mode, do not set it):
#   dry_run    = nothing is sent; the exact payload is stored for review (reads use production, read-only)
#   trial      = Ergani II TEST environment (trialv2eservices.yeka.gr): stamped «ΑΚΥΡΟ», no legal effect
#   production = real submissions (eservices.yeka.gr)
ERGANI_MODE=dry_run
# Production web-services user (Εξωτερικός χρήστης / API user of the employer)
ERGANI_USERNAME=
ERGANI_PASSWORD=
# Test-environment user, created in https://trialv2eservices.yeka.gr (TaxisNet login of the employer)
ERGANI_TRIAL_USERNAME=
ERGANI_TRIAL_PASSWORD=
# Login type: 01 = API user, 02 = «ΕΡΓΑΝΗ» user from «Εξωτερικοί Χρήστες Παραρτημάτων»
ERGANI_USER_TYPE=01
ERGANI_TRIAL_USER_TYPE=02
# Employer AFM (9 digits) and branch number (Α/Α παραρτήματος, e.g. 0)
EMPLOYER_AFM=
BRANCH_NUMBER=0

# ---- Cloudflare Access (admin at /admin) ----
# Team domain WITHOUT https://, e.g. yourteam.cloudflareaccess.com
CF_ACCESS_TEAM_DOMAIN=
# Application Audience (AUD) tag of the Access application
CF_ACCESS_AUD=
# Comma-separated list of admin emails (must match the Access policy)
ADMIN_EMAILS=

# ---- App ----
PUBLIC_ORIGIN=https://karta.example.com
# Retries later than this (seconds after the movement) carry a late-declaration justification
LATE_THRESHOLD_SECONDS=120
# Minimum seconds between two movements of the same employee
DEBOUNCE_SECONDS=60

# ---- Phone alerts (optional): same ntfy server/topic as the DR backup alerts ----
NTFY_URL=
NTFY_TOPIC=
NTFY_TOKEN=

# ---- Admin can view current PINs (optional) ----
# Generate once:  python3 -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Losing this key only means PINs can't be shown any more (they keep working); press «Νέο PIN» to re-seal.
PIN_KEY=

# Optional: your employer id in Ergani (the "id:" inside Ergani's employee QR). When set, the kiosk
# refuses an Ergani QR issued by another employer.
# ERGANI_EMPLOYER_ID=
